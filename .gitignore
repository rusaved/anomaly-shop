docs/evidence/**/*.mp4

# studio renders (only the shots the producer picks go to git)
art/studio/*/

# secrets and local settings
.env
.env.*
*.pem
*.key
.claude/settings.local.json
.claude/worktrees/
CLAUDE.local.md

# system junk
*.log
.DS_Store
Thumbs.db
